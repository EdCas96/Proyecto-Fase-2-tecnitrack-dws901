<%#
  Estado del ticket del cliente (prototipo: cliente/ticket-estado.html): estado actual,
  fecha estimada, equipo e historial. La cotización y aprobar/rechazar se agregan en el paso 7 (HU-05).
%>
<div class="status-hero">
  <p class="breadcrumb">Ticket <%= ticket.folio %> · <%= ticket.cliente %></p>
  <h1>Estado actual</h1>
  <%- include('../partials/badgeEstado', { estado: ticket.estado, grande: true }) %>
</div>

<div class="detail-grid">
  <div class="detail-card">
    <div class="detail-list">
      <div><span class="detail-label">Equipo</span><span class="detail-value"><%= ticket.equipo %></span></div>
      <div><span class="detail-label">Fecha de ingreso</span><span class="detail-value"><%= formatoFecha(ticket.fechaIngreso) %></span></div>
      <% if (ticket.fechaEntrega) { %>
        <div><span class="detail-label">Fecha de entrega</span><span class="detail-value"><%= formatoFecha(ticket.fechaEntrega) %></span></div>
      <% } else if (ticket.estado !== 'Cancelado') { %>
        <div><span class="detail-label">Fecha estimada de entrega</span><span class="detail-value"><%= ticket.fechaEstimada ? formatoFecha(ticket.fechaEstimada) : 'Por confirmar' %></span></div>
      <% } %>
    </div>
  </div>
</div>

<div class="section-header">
  <h2>Historial de tu ticket</h2>
</div>
<ul class="timeline">
  <% ticket.historial.forEach((cambio) => { %>
    <li class="timeline-item">
      <span class="timeline-date"><%= formatoFecha(cambio.fecha) %></span>
      <span class="timeline-title"><%= etiquetaEstado(cambio.estado) %></span>
    </li>
  <% }) %>
</ul>

<% if (cotizacion) { %>
  <div class="section-header">
    <h2>Cotización</h2>
    <% if (cotizacion.estado !== 'Pendiente') { %>
      <p class="text-small">Estado: <%- include('../partials/badgeEstado', { estado: cotizacion.estado }) %></p>
    <% } %>
  </div>

  <div class="detail-grid">
    <div class="detail-card">
      <p class="text-small">Equipo: <%= ticket.equipo %> · Enviada el <%= formatoFecha(cotizacion.fecha) %></p>
      <div class="detail-list">
        <% cotizacion.items.forEach((item) => { %>
          <div>
            <span class="detail-label"><%= item.catalogoItem ? item.catalogoItem.nombre : 'Ítem' %><% if (item.cantidad > 1) { %> × <%= item.cantidad %><% } %></span>
            <span class="detail-value"><%= formatoPrecio(item.subtotal) %></span>
          </div>
        <% }) %>
        <div><span class="detail-label"><strong>Total</strong></span><span class="detail-value"><strong><%= formatoPrecio(cotizacion.total) %></strong></span></div>
      </div>
    </div>
  </div>

  <% if (cotizacion.estado === 'Pendiente') { %>
    <div class="state-actions acciones-respuesta">
      <form method="post" action="/portal/cotizaciones/<%= cotizacion.id %>/aprobar"
            data-confirmar="¿Aprobar la cotización por <%= formatoPrecio(cotizacion.total) %>? El técnico comenzará la reparación.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-primary">Aprobar cotización</button>
      </form>
      <form class="form-rechazo" method="post" action="/portal/cotizaciones/<%= cotizacion.id %>/rechazar"
            data-confirmar="¿Rechazar la cotización? El servicio se cancelará y podrás retirar tu equipo.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="motivo">Motivo del rechazo (opcional)</label>
          <textarea id="motivo" name="motivo" rows="2" maxlength="200" placeholder="Ej. El precio es más alto de lo esperado"><%= datos.motivo || '' %></textarea>
          <%- include('../partials/errorCampo', { campo: 'motivo' }) %>
        </div>
        <button type="submit" class="btn btn-destructive">Rechazar cotización</button>
      </form>
    </div>
  <% } %>
<% } %>

<form class="acciones-portal" method="post" action="/portal/salir">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button type="submit" class="btn btn-secondary">Salir</button>
</form>
