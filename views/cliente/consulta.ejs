<%# Portal del cliente: acceso con folio + teléfono (prototipo: cliente/consulta.html) %>
<main class="pantalla-centrada">
  <div class="role-select-card">
    <p class="role-select-logo">TecniTrack</p>
    <p class="role-select-subtitle">Consulta el estado de tu ticket de servicio</p>

    <form class="form-tarjeta" method="post" action="/portal" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="folio">Folio del ticket</label>
        <input type="text" id="folio" name="folio" required placeholder="Ej. TT-2026-0040"
               value="<%= datos.folio || '' %>" <% if (errores.folio) { %>aria-invalid="true"<% } %>>
      </div>
      <div class="form-group">
        <label for="telefono">Teléfono registrado</label>
        <input type="tel" id="telefono" name="telefono" required placeholder="Ej. 7345-6720"
               value="<%= datos.telefono || '' %>" <% if (errores.telefono) { %>aria-invalid="true"<% } %>>
      </div>

      <div class="role-select-options">
        <button type="submit" class="btn btn-primary">Consultar</button>
        <a class="btn btn-secondary" href="/login">Soy personal del taller</a>
      </div>
    </form>
  </div>
</main>
