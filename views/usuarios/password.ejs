<%# Restablecer la contraseña de un usuario (el admin asigna una temporal) %>
<div class="section-header">
  <%- include('../partials/breadcrumbs') %>
  <h1>Restablecer contraseña</h1>
  <p class="text-small"><%= usuario.nombre %> · <%= usuario.correo %></p>
</div>

<form class="form-container" method="post" action="/usuarios/<%= usuario.id %>/password" novalidate
      data-confirmar="¿Cambiar la contraseña de <%= usuario.nombre %>? La anterior dejará de funcionar.">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="_method" value="PUT">

  <div class="form-group">
    <label for="password">Nueva contraseña temporal</label>
    <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password"<% if (errores.password) { %> aria-invalid="true" aria-describedby="error-password"<% } %>>
    <%- include('../partials/errorCampo', { campo: 'password' }) %>
  </div>
  <p class="form-ayuda">Mínimo 8 caracteres, con al menos una letra y un número.</p>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Restablecer</button>
    <a class="btn btn-secondary" href="/usuarios">Cancelar</a>
  </div>
</form>
