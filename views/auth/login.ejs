<%# Inicio de sesión del personal (como la pantalla de inicio del prototipo de la Fase 1) %>
<main class="pantalla-centrada">
  <div class="role-select-card">
    <p class="role-select-logo">TecniTrack</p>
    <p class="role-select-subtitle">Sistema de gestión de servicio técnico de computadoras</p>

    <form class="form-tarjeta" method="post" action="/login" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="correo">Correo</label>
        <input type="email" id="correo" name="correo" autocomplete="username" required
               placeholder="usuario@tecnitrack.com" value="<%= datos.correo || '' %>"
               <% if (errores.correo) { %>aria-invalid="true"<% } %>>
      </div>
      <div class="form-group">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required
               <% if (errores.password) { %>aria-invalid="true"<% } %>>
      </div>

      <div class="role-select-options">
        <button type="submit" class="btn btn-primary">Iniciar sesión</button>
        <a class="btn btn-secondary" href="/portal">Consultar mi ticket (Cliente)</a>
      </div>
    </form>
  </div>
</main>
