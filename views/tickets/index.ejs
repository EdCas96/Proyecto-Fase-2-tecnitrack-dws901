<%# Listado de tickets (prototipo: admin/tickets.html). Admin: todos; técnico: solo los suyos (lo filtra TicketService) %>
<% const admin = esAdmin(usuarioActual); %>
<div class="section-header">
  <%- include('../partials/breadcrumbs') %>
  <h1><%= titulo %></h1>
</div>

<form class="table-filters" method="get" action="/tickets" role="search">
  <div class="form-group">
    <label for="estado">Estado</label>
    <select id="estado" name="estado">
      <option value="">Todos</option>
      <option value="abiertos"<%= filtros.estado === 'abiertos' ? ' selected' : '' %>>Abiertos (sin entregar ni cancelar)</option>
      <% estados.forEach((estado) => { %>
        <option value="<%= estado %>"<%= filtros.estado === estado ? ' selected' : '' %>><%= etiquetaEstado(estado) %></option>
      <% }) %>
    </select>
  </div>
  <div class="form-group">
    <label for="q">Buscar por folio o cliente</label>
    <input type="search" id="q" name="q" value="<%= filtros.q %>" placeholder="Ej. TT-2026-0040 o Ana">
  </div>
  <button type="submit" class="btn btn-secondary">Filtrar</button>
  <% if (filtros.estado || filtros.q) { %><a class="btn btn-secondary" href="/tickets">Limpiar</a><% } %>
</form>

<div class="page-actions">
  <p class="text-small"><%= paginacion.total %> ticket<%= paginacion.total === 1 ? '' : 's' %> <%= filtros.estado || filtros.q ? 'encontrados' : (admin ? 'registrados' : 'asignados a ti') %></p>
  <a class="btn btn-primary" href="/tickets/nuevo">Nuevo ticket</a>
</div>

<div class="table-wrapper">
  <table class="table-standard">
    <thead>
      <tr>
        <th>Folio</th>
        <th>Cliente</th>
        <th>Equipo</th>
        <th>Estado</th>
        <% if (admin) { %><th>Técnico asignado</th><% } %>
        <th>Fecha de ingreso</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% paginacion.registros.forEach((ticket) => { %>
        <tr>
          <td><%= ticket.folio %></td>
          <td><%= ticket.equipo.cliente.nombre %></td>
          <td><%= descripcionEquipo(ticket.equipo) %></td>
          <td><%- include('../partials/badgeEstado', { estado: ticket.estado }) %></td>
          <% if (admin) { %><td><%= ticket.tecnico ? ticket.tecnico.nombre : 'Sin asignar' %></td><% } %>
          <td><%= formatoFecha(ticket.fecha_ingreso) %></td>
          <td><a class="btn btn-secondary" href="/tickets/<%= ticket.id %>">Ver detalle</a></td>
        </tr>
      <% }) %>
      <% if (!paginacion.registros.length) { %>
        <tr><td colspan="<%= admin ? 7 : 6 %>" class="tabla-vacia">No hay tickets que coincidan con el filtro.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/paginacion', { rutaBase: '/tickets' }) %>
