<main class="pantalla-centrada">
  <div class="role-select-card">
    <p class="role-select-logo">TecniTrack</p>
    <p class="role-select-subtitle">Sistema de gestión de servicio técnico de computadoras</p>

    <%# Estados por los que pasa un ticket, con sus colores semánticos %>
    <p class="text-small">Así avanza el servicio de tu equipo:</p>
    <div class="leyenda-estados">
      <% estados.forEach((estado) => { %>
        <%- include('partials/badgeEstado', { estado }) %>
      <% }) %>
    </div>

    <div class="role-select-options">
      <a class="btn btn-primary" href="/login">Iniciar sesión (personal)</a>
      <a class="btn btn-secondary" href="/portal">Consultar mi ticket (clientes)</a>
    </div>
  </div>
</main>
