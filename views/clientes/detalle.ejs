<%# Detalle del cliente con sus equipos %>
<% const admin = esAdmin(usuarioActual); const equipos = cliente.equipos || []; %>
<div class="section-header">
  <%- include('../partials/breadcrumbs') %>
  <h1><%= cliente.nombre %></h1>
</div>

<div class="detail-grid">
  <section class="detail-card">
    <h2>Datos del cliente</h2>
    <div class="detail-list">
      <div><span class="detail-label">Teléfono</span><span class="detail-value"><%= cliente.telefono %></span></div>
      <div><span class="detail-label">Correo</span><span class="detail-value"><%= cliente.correo || '—' %></span></div>
      <div><span class="detail-label">Equipos registrados</span><span class="detail-value"><%= equipos.length %></span></div>
    </div>
    <% if (admin) { %>
      <div class="detalle-acciones">
        <a class="btn btn-secondary" href="/clientes/<%= cliente.id %>/editar">Editar cliente</a>
        <%- include('../partials/botonAccion', {
          accion: `/clientes/${cliente.id}`, metodo: 'DELETE', texto: 'Eliminar cliente', clase: 'btn-destructive',
          confirmar: `¿Eliminar al cliente ${cliente.nombre}? Esta acción no se puede deshacer.`,
        }) %>
      </div>
    <% } %>
  </section>
</div>

<div class="page-actions">
  <h2>Equipos</h2>
  <% if (admin) { %><a class="btn btn-primary" href="/equipos/nuevo?cliente_id=<%= cliente.id %>">Agregar equipo</a><% } %>
</div>

<div class="table-wrapper">
  <table class="table-standard">
    <thead>
      <tr>
        <th>Tipo</th>
        <th>Marca</th>
        <th>Modelo</th>
        <th>Número de serie</th>
        <th>Tickets</th>
        <% if (admin) { %><th>Acciones</th><% } %>
      </tr>
    </thead>
    <tbody>
      <% equipos.forEach((equipo) => { %>
        <tr>
          <td><a href="/equipos/<%= equipo.id %>"><%= equipo.tipo %></a></td>
          <td><%= equipo.marca %></td>
          <td><%= equipo.modelo %></td>
          <td><%= equipo.numero_serie || '—' %></td>
          <td><%= equipo.get('totalTickets') %></td>
          <% if (admin) { %>
            <td>
              <a class="btn btn-secondary" href="/equipos/<%= equipo.id %>/editar">Editar</a>
              <%- include('../partials/botonAccion', {
                accion: `/equipos/${equipo.id}`, metodo: 'DELETE', texto: 'Eliminar', clase: 'btn-destructive',
                confirmar: `¿Eliminar el equipo ${equipo.marca} ${equipo.modelo}?`,
              }) %>
            </td>
          <% } %>
        </tr>
      <% }) %>
      <% if (!equipos.length) { %>
        <tr><td colspan="<%= admin ? 6 : 5 %>" class="tabla-vacia">Este cliente aún no tiene equipos registrados.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/historialTickets', { tickets, mostrarEquipo: true }) %>
