<%# Barra superior y submenú según el rol (como en el prototipo de la Fase 1) %>
<% const usuario = locals.usuarioActual; %>
<header class="navbar">
  <a class="navbar-brand" href="<%= usuario ? (usuario.rol === 'admin' ? '/admin' : '/tecnico') : '/' %>">TecniTrack</a>
  <% if (usuario) { %>
    <div class="navbar-user">
      <span class="navbar-role"><%= etiquetaRol(usuario) %></span>
      <% const noLeidas = locals.notificacionesNoLeidas || 0; %>
      <a class="navbar-link navbar-campana" href="/notificaciones" data-notificaciones
         aria-label="Notificaciones: <%= noLeidas %> sin leer" title="Notificaciones">
        <span aria-hidden="true">&#128276;</span>
        <span class="contador-notificaciones" data-contador<% if (!noLeidas) { %> hidden<% } %>><%= noLeidas %></span>
      </a>
      <form class="navbar-logout" method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="navbar-link">Cerrar sesión</button>
      </form>
    </div>
  <% } else if (locals.clienteEnPortal) { %>
    <span class="navbar-role">Cliente</span>
  <% } else { %>
    <nav class="navbar-links" aria-label="Accesos públicos">
      <a class="navbar-link" href="/portal">Consultar mi ticket</a>
      <a class="navbar-link" href="/login">Iniciar sesión</a>
    </nav>
  <% } %>
</header>

<% if (usuario) { %><script src="/js/notificaciones.js" defer></script><% } %>

<% const menu = menuPorRol(usuario); %>
<% if (menu.length) { %>
  <nav class="subnav" aria-label="Menú principal">
    <% menu.forEach(({ texto, url }) => { %>
      <a href="<%= url %>"<% if (esRutaActiva(locals.rutaActual || '', url)) { %> class="active" aria-current="page"<% } %>><%= texto %></a>
    <% }) %>
  </nav>
<% } %>
