# Entorno de pruebas (Jest). Base de datos separada: se borra y recrea en las pruebas.
NODE_ENV=test
PORT=3001

# Conexión a MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tecnitrack_test
DB_USER=root
DB_PASSWORD=

# Secreto para firmar la cookie de sesión y los tokens CSRF (cadena larga y aleatoria)
SESSION_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio

# RN-05: días tras los cuales una cotización Pendiente se muestra como "Pendiente de respuesta"
DIAS_LIMITE_COTIZACION=7

# Tamaño máximo de cada foto subida, en MB
MAX_FOTO_MB=5
